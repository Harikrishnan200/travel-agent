APP_ENV=development
LOG_LEVEL=INFO

# --- LLM ---
PRIMARY_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=gemini
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.6-flash

# --- Infrastructure ---
DATABASE_URL=postgresql+psycopg://travel:travel@localhost:5432/travel
REDIS_URL=redis://localhost:6379/0

# --- MCP Gateway ---
MCP_GATEWAY_URL=http://localhost:9000
TRANSPORT_MCP_URL=http://localhost:9101/mcp
HOTELS_MCP_URL=http://localhost:9102/mcp
PLACES_MCP_URL=http://localhost:9103/mcp
WEATHER_MCP_URL=http://localhost:9104/mcp

# false = one process (agents, gateway and MCP servers together). true = real HTTP hops.
SPLIT_PROCESSES=false
MCP_GATEWAY_API_KEY=dev-gateway-key
TOOL_RATE_LIMIT_PER_MINUTE=60

# --- Data source ---
# true = fully offline mock data, no API keys needed
USE_MOCK_DATA=true

# Optional. Real flight schedules (aviationstack.com) and real place discovery
# (tavily.com); both have free tiers. Leave blank to use mock data.
AVIATION_STACK_API_KEY=
TAVILY_API_KEY=
